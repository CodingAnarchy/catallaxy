# Compression toys: run-length encoding with a validating decoder, and a Huffman code built with
# deterministic tie-breaking (weight, then creation order).

fn rle_encode(s: String) -> String {
  sb = StringBuilder.new()
  chars = s.chars
  i = 0
  while i < chars.length {
    j = i
    while j < chars.length and chars[j] == chars[i] { j += 1 }
    sb.push((j - i).to_s)
    sb.push(chars[i])
    i = j
  }
  sb.to_s
}

fn rle_decode(s: String) -> Result[String, String] {
  sb = StringBuilder.new()
  count = 0
  digits = 0
  chars = s.chars
  for i in 0...chars.length {
    c = chars[i]
    if c.is_digit {
      count = count * 10 + c.to_i!
      digits += 1
    } else {
      if digits == 0 { return Err("missing count before `#{c}` at #{i}") }
      if count == 0 { return Err("zero count before `#{c}` at #{i}") }
      sb.push(c * count)
      count = 0
      digits = 0
    }
  }
  if digits > 0 { return Err("dangling count #{count} at end") }
  Ok(sb.to_s)
}

enum Tree {
  Leaf(String)
  Node(Tree, Tree)
}

class Weighted {
  weight: Int
  order: Int
  tree: Tree
}

fn build_huffman(text: String) -> Tree {
  freq: Dict[String, Int] = [:]
  for c in text { freq[c] = (freq[c] ?? 0) + 1 }
  queue: List[Weighted] = []
  for (sym, n) in freq { queue.push(Weighted.new(n, queue.length, Tree.Leaf(sym))) }
  next_order = queue.length
  while queue.length > 1 {
    queue = queue.sort_with { |a, b|
      if a.weight != b.weight { a.weight <=> b.weight } else { a.order <=> b.order }
    }
    left = queue.shift()!
    right = queue.shift()!
    queue.push(Weighted.new(left.weight + right.weight, next_order, Tree.Node(left.tree, right.tree)))
    next_order += 1
  }
  queue[0].tree
}

fn assign_codes(t: Tree, prefix: String, out: Dict[String, String]) -> Nil {
  match t {
    .Leaf(sym) => out[sym] = if prefix.is_empty() { "0" } else { prefix }
    .Node(l, r) => {
      assign_codes(l, prefix + "0", out)
      assign_codes(r, prefix + "1", out)
    }
  }
}

fn huffman_decode(root: Tree, bits: String) -> String {
  sb = StringBuilder.new()
  node = root
  for b in bits {
    match node {
      .Node(l, r) => node = if b == "0" { l } else { r }
      .Leaf(_) => panic("walked past a leaf")
    }
    match node {
      .Leaf(sym) => {
        sb.push(sym)
        node = root
      }
      .Node(_, _) => {}
    }
  }
  sb.to_s
}

fn demo_rle() {
  stripes = "W" * 12 + "B" + "W" * 12 + "B" * 3 + "W" * 24 + "B" + "W" * 14
  for s in [stripes, "aaabccddd", "abc", ""] {
    enc = rle_encode(s)
    back = rle_decode(enc).unwrap()
    puts("#{s.length} -> #{enc.length} chars: #{inspect(enc)} (round trip: #{back == s})")
  }
  for bad in ["3", "a2", "2a0b", "10x2y"] {
    match rle_decode(bad) {
      Ok(v) => puts("#{bad} => #{v}")
      Err(e) => puts("#{bad} => error: #{e}")
    }
  }
}

fn demo_huffman(text: String) {
  tree = build_huffman(text)
  codes: Dict[String, String] = [:]
  assign_codes(tree, "", codes)
  for sym in codes.keys.sorted() { puts("#{sym}: #{codes[sym]!}") }
  sb = StringBuilder.new()
  for c in text { sb.push(codes[c]!) }
  bits = sb.to_s
  puts(bits)
  puts("#{bits.length} bits instead of #{text.length * 8}")
  puts("decoded: #{huffman_decode(tree, bits)}")
}

demo_rle()
puts()
demo_huffman("abracadabra")
