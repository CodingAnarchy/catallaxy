# Data-parallel number crunching with par_map, par_reduce, par_select and par_each.
# Every result is checked against a closed form or a sequential computation.

fn is_prime(n: Int) -> Bool {
  if n < 2 { return false }
  if n % 2 == 0 { return n == 2 }
  d = 3
  while d * d <= n {
    if n % d == 0 { return false }
    d += 2
  }
  true
}

fn collatz_steps(start: Int) -> Int {
  n = start
  steps = 0
  while n != 1 {
    n = if n.is_even { n / 2 } else { 3 * n + 1 }
    steps += 1
  }
  steps
}

fn divisor_sum(n: Int) -> Int {
  if n == 1 { return 0 }
  total = 1
  d = 2
  while d * d <= n {
    if n % d == 0 {
      total += d
      if d * d != n { total += n / d }
    }
    d += 1
  }
  total
}

# Sum of squares: par_map then par_reduce; compare with n(n+1)(2n+1)/6.
n = 100_000
nums = (1..n).to_list()
squares = nums.par_map { |x| x * x }
total = squares.par_reduce(0) { |a, b| a + b }
puts("sum of squares 1..#{n} = #{total}")
puts("closed form          = #{n * (n + 1) * (2 * n + 1) / 6}")

# Primes below 50,000 with par_select.
candidates = (2...50_000).to_list()
primes = candidates.par_select { |c| is_prime(c) }
puts("primes below 50000: #{primes.length}")
puts("last five: #{primes.slice(primes.length - 5, 5)}")
largest_gap = 0
gap_at = 0
for i in 1...primes.length {
  g = primes[i] - primes[i - 1]
  if g > largest_gap {
    largest_gap = g
    gap_at = primes[i - 1]
  }
}
puts("largest gap: #{largest_gap} after #{gap_at}")

# Longest Collatz chain for starts below 100,000.
starts = (1...100_000).to_list()
steps = starts.par_map { |s| collatz_steps(s) }
best = 0
for i in 1...steps.length {
  if steps[i] > steps[best] { best = i }
}
puts("longest collatz chain below 100000: start #{starts[best]}, #{steps[best]} steps")
max_steps = steps.par_reduce(0) { |a, b| a.max(b) }
puts("par_reduce agrees: #{max_steps == steps[best]}")

# Perfect numbers below 10,000, found with par_each feeding shared accumulators.
found = Atomic.new(0)
found_sum = Atomic.new(0)
perfect: Mutex[List[Int]] = Mutex.new([])
(2...10_000).to_list().par_each { |k|
  if divisor_sum(k) == k {
    found.add(1)
    found_sum.add(k)
    perfect.lock { |l| l.push(k) }
  }
}
puts("perfect numbers: #{perfect.lock { |l| l.sorted() }} (count #{found.get()}, sum #{found_sum.get()})")

# Parallel and sequential agree on a floating-point series (summed in a fixed order).
terms = (0...200_000).to_list().par_map { |k|
  sign = if k % 2 == 0 { 1.0 } else { -1.0 }
  sign / (2 * k + 1).to_f
}
pi_estimate = 4.0 * terms.reduce(0.0) { |a, b| a + b }
puts("pi ~ #{pi_estimate.format(5)}")
