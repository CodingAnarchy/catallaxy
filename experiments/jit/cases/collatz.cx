fn steps(n: Int) -> Int {
  s = 0
  while n != 1 {
    if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
    s += 1
  }
  s
}
fn longest(limit: Int) -> Int {
  best = 0
  arg = 0
  i = 1
  while i <= limit {
    k = steps(i)
    if k > best {
      best = k
      arg = i
    }
    i += 1
  }
  arg * 1000 + best
}
puts(longest(300000))
