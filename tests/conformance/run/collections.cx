xs = [5, 3, 8, 1]
xs.push(9)
puts(xs)
puts(xs.pop())
puts(xs.length)
puts(xs.sort())
puts(xs.sort().reverse())
puts(xs.first())
puts(xs.last())
puts(xs.index_of(8))
puts(xs.contains(3))
puts(xs[1..2])
puts(xs.take(2))
puts(xs.drop(2))
puts(xs.min())
puts(xs.max())
puts(xs.sum())
puts(xs.any { |x| x > 7 })
puts(xs.all { |x| x > 0 })
puts(xs.count { |x| x > 2 })
puts(xs.find { |x| x > 4 })
puts(xs.with_index().length)
xs.insert(0, 100)
puts(xs)
xs.remove_at(-1)
puts(xs)
puts(xs + [7])
ys = xs.dup()
ys[0] = -1
puts(xs[0])
puts([3, 1, 2].sort_with { |a, b| b <=> a })
puts(List.filled(3, "x"))
puts([[1, 2], [3, 4]].map { |p| p[0] + p[1] })
puts([1, 2, 3, 4, 5, 6].chunk(4))
puts([1, 2, 3].rotate())

d = [one: 1, two: 2]
d["three"] = 3
puts(d.length)
puts(d.has_key("two"))
puts(d.delete("one"))
puts(d)
puts(d.values)
puts(d.map { |e| e.0 })
puts(d.fetch("zzz", 0))
nums: Dict[Int, String] = [1: "a", 2: "b"]
puts(nums[2])
puts(nums.invert())
merged = d.merge(["four": 4])
puts(merged.keys)
inv = [(1, 2): "pair"]
puts(inv[(1, 2)])

s = Set.from([1, 2, 2, 3])
puts(s.length)
s.add(4)
puts(s.contains(4))
puts(s.contains(9))
puts(Set.from([1, 2]) | Set.from([2, 3]))
puts((Set.from([1, 2, 3]) & Set.from([2, 3, 4])).to_list())
puts([3, 3, 1].to_set().length)

t = (1, "two", 3.0)
puts(t)
let (a, b, c) = t
puts(b)
puts(t.2)
pairs = [(1, "a"), (2, "b")]
for (n, l) in pairs { print("#{n}#{l} ") }
puts()
puts((1, 2) == (1, 2))
puts([1, [2, 3]] == [1, [2, 3]])
