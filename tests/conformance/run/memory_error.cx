# Requests too large to satisfy panic with a MemoryError instead of aborting the process, so a
# thread's join reports them like any other panic.
fn huge_list() -> Int {
  xs = List.filled(100_000_000_000_000, 0)
  xs.length
}
fn attempt(name: String, f: fn() -> Int) {
  t = spawn move { f() }
  match t.join() {
    Ok(n) => puts("#{name}: ok #{n}")
    # The reason in parentheses depends on the machine. `join` gives the message only (an
    # unjoined thread's panic is reported with its trace at exit).
    Err(e) => puts("#{name}: #{e.split(" (")[0]}, message only: #{not e.contains("\n")}")
  }
}
attempt("filled") { huge_list() }
attempt("overflow") { List.filled(4_000_000_000_000_000_000, nil).length }
attempt("repeat") { ("ab" * 100_000_000_000_000).length }
attempt("ljust") { "x".ljust(100_000_000_000_000).length }
attempt("center") { "x".center(100_000_000_000_000, "ab").length }
attempt("negative capacity") { List.with_capacity(-1).length }
attempt("negative size") { List.filled(-1, 0).length }
# Sizes that fit still work.
attempt("small") { List.filled(3, 7).sum() + ("ab" * 3).length + "x".rjust(4, "-").length }
