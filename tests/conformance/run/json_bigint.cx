# Big integers round-trip through JSON as numbers, not strings.
d = Json.parse("{\"big\": 12345678901234567890}").unwrap()
puts(Json.stringify(d))
huge: Dyn = ["n": 2 ** 100, "neg": -(2 ** 70), "small": 7, "list": [2 ** 64, 1.5, nil, "s\"q"], "e": [], "o": [:]]
puts(Json.stringify(huge))
puts(Json.pretty(huge))
again = Json.parse(Json.stringify(d)).unwrap()
puts(again["big"] == 12345678901234567890)

# Integers wider than 64 bits parse as Int and are written back digit for digit.
wide = Json.parse("[123456789012345678901234567890, -98765432109876543210987654321, 18446744073709551615, -9223372036854775809, -0]").unwrap()
puts(Json.stringify(wide))
puts(wide[0] as? Int)
puts((wide[0] as? Int ?? 0) + 1)
puts(wide[1] as? Int)
puts(wide[4] as? Int)
nested = Json.parse("{\"a\": {\"b\": [1e2, 2.5, 100000000000000000000000, \"x\\u00e9\\\"\"]}, \"z\": 340282366920938463463374607431768211456}").unwrap()
puts(Json.stringify(nested))
puts(nested["a"]["b"][0] as? Float)
puts(nested["a"]["b"][2] as? Int)
puts(Json.parse(Json.stringify(nested)).unwrap()["z"] == 2 ** 128)
