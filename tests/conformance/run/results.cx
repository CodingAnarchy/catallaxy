fn parse_age(s: String) -> Result[Int, String] {
  match s.to_i {
    nil => Err("not a number: #{s}")
    n: Int => if n < 0 { Err("negative: #{n}") } else { Ok(n) }
  }
}

fn total_age(a: String, b: String) -> Result[Int, String] {
  x = parse_age(a)?
  y = parse_age(b)?
  Ok(x + y)
}

puts(total_age("20", "22"))
puts(total_age("20", "x"))
puts(total_age("-1", "3"))
r = parse_age("41")
puts(r.is_ok())
puts(r.map { |v| v + 1 }.unwrap())
puts(parse_age("?").unwrap_or(0))
match total_age("1", "2") {
  Ok(v) => puts("ok #{v}")
  Err(e) => puts("error #{e}")
}
if let Ok(v) = parse_age("5") { puts("got #{v}") }
fn first_char(s: String) -> String? {
  if s.is_empty() { return nil }
  s[0]
}
fn initials(a: String, b: String) -> String? {
  x = first_char(a)?
  y = first_char(b)?
  x + y
}
puts(initials("Grace", "Hopper"))
puts(initials("", "Hopper"))
puts(parse_age("x").err())
