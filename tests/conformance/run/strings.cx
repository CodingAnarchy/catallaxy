s = "Hello, World"
puts(s.length)
puts(s.upcase)
puts(s.downcase)
puts(s[0])
puts(s[-1])
puts(s[7..11])
puts(s.slice(0, 5))
puts(s.split(", "))
puts("  a  b c ".split())
puts(s.contains("World"))
puts(s.starts_with("Hell"))
puts(s.index_of("o"))
puts(s.index_of("o", 5))
puts(s.replace("l", "L"))
puts(s.reverse)
puts(s.chars.length)
puts("  pad ".strip + "|")
puts("x".center(5, "*"))
puts("7".rjust(3, "0"))
puts("abc" * 3)
puts("a,b,,c".split(","))
puts(("42".to_i ?? 0) + 1)
puts("4.5".to_f)
puts("nope".to_i == nil)
puts("héllo".length)
puts("héllo".upcase)
puts("héllo"[1])
puts("line1\nline2".lines())
name = "Ada"
age = 36
puts("#{name} is #{age} years old; next year #{age + 1}")
puts('raw #{not} interpolated')
puts("tab\there")
puts("quote \" and backslash \\")
puts("unicode \u{1F600}".length)
sb = StringBuilder.new()
for i in 0...5 { sb.push(i.to_s) }
sb.push_value(3.5)
puts(sb.to_s)
words = ["b", "c", "a"]
puts(words.sort().join("-"))
puts(words.join())
puts("abc" < "abd")
puts("b" > "a")
puts("x" == "x")
puts("Mississippi".count("ss"))
puts("Mississippi".squeeze)
puts("hello world".capitalize)
puts("ab".ord)
puts(97.chr)
puts(inspect("q\"uote"))
puts("CamelCase".is_upper)
puts("abc".tr("abc", "xyz"))
