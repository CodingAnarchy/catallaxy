class Node {
  value: Int
  next: Node? = nil
}
a = Node.new(1, Node.new(2, Node.new(3)))
puts(a.next?.value)
puts(a.next?.next?.next?.value)
puts(a.next!.next!.value)
x: Int? = nil
puts(x ?? 7)
x = 5
puts(x + 1)

fn find(xs: List[Int], target: Int) -> Int? {
  for (x, i) in xs.with_index() {
    if x == target { return i }
  }
  nil
}
idx = find([4, 5, 6], 6)
if let i = idx {
  puts("found at #{i}")
} else {
  puts("missing")
}
puts(find([1], 9) == nil)

fn len_or_zero(s: String?) -> Int {
  if s == nil { return 0 }
  s.length
}
puts(len_or_zero("abc"))
puts(len_or_zero(nil))

fn first_even(xs: List[Int]) -> Int? {
  for x in xs { if x.is_even { return x } }
  nil
}
v = first_even([1, 3, 8, 10])
puts(v != nil and v > 5)
name: String? = nil
name ??= "default"
puts(name)
counter: Int? = nil
puts(counter?.to_s ?? "none")
