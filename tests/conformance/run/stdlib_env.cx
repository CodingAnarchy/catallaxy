# Env.set / Env.remove / Env.all: the program's environment, inherited by child processes.

puts(Env.get("CATX_TEST_UNSET_VAR"))
Env.set("CATX_TEST_VAR", "one")
puts(Env.get("CATX_TEST_VAR"))
Env.set("CATX_TEST_VAR", "two")
puts(Env.all()["CATX_TEST_VAR"])

# Visible from other threads and fibers.
t = spawn { Env.get("CATX_TEST_VAR") }
puts(t.join().unwrap())
f = Fiber.start { Env.set("CATX_TEST_FIBER", "yes") }
f.join().unwrap()
puts(Env.get("CATX_TEST_FIBER"))

# `all` is sorted by name and reflects removals.
keys = Env.all().keys()
puts(keys == keys.sorted())
Env.remove("CATX_TEST_FIBER")
puts(Env.get("CATX_TEST_FIBER"))
puts(Env.all().has_key("CATX_TEST_FIBER"))

# Child processes inherit the changes; a per-call `env` still wins.
tmp = Env.get("TMPDIR") ?? Env.get("TEMP") ?? Env.get("TMP") ?? "/tmp"
root = Path.join(tmp, "catx_env_#{Time.millis()}_#{Random.int(0, 1000000)}")
Dir.create(root, recursive: true).unwrap()
Process.run("git", ["init", "-q"], dir: root).unwrap()
Env.set("GIT_AUTHOR_NAME", "Ada")
Env.set("GIT_AUTHOR_EMAIL", "ada@example.com")
Env.set("GIT_AUTHOR_DATE", "1700000000 +0000")
puts(Process.run("git", ["var", "GIT_AUTHOR_IDENT"], dir: root).unwrap().stdout.strip)
over = ["GIT_AUTHOR_NAME": "Grace"]
puts(Process.run("git", ["var", "GIT_AUTHOR_IDENT"], env: over, dir: root).unwrap().stdout.strip)
Dir.remove(root, recursive: true).unwrap()
