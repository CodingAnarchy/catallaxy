# `x ?? d` where `x` is known to be nil (narrowed, or the literal) has the type of `d`.
# (Found by tools/difffuzz.)
fn double_or_seven(a: Int?) -> Int {
  if a == nil {
    return (a ?? 7) * 2
  }
  a * 2
}
fn next_or_one(a: Int?) -> Int {
  match a {
    nil => (a ?? -1).abs()
    v: Int => v + 1
  }
}
puts(double_or_seven(nil))
puts(double_or_seven(4))
puts(next_or_one(nil))
puts(next_or_one(4))
n: Int = nil ?? 3
puts(n + 1)
