# Format specs in interpolation, String.format and Int.to_s(base).
pi = 3.14159
n = 1234567
puts("[#{pi:.2f}] [#{pi:>8.3f}] [#{pi:<8.1f}] [#{pi:^9.2f}] [#{-pi:08.2f}]")
puts("[#{n:,}] [#{n:_}] [#{n:>12,}] [#{n:012,}] [#{-n:+}] [#{n:+d}] [#{5: d}]")
puts("[#{255:x}] [#{255:X}] [#{255:#x}] [#{255:#X}] [#{8:o}] [#{8:#o}] [#{5:b}] [#{5:#010b}]")
puts("[#{0xdeadbeef:_x}] [#{-255:#x}] [#{n:=+12}]")
puts("[#{1234.5:e}] [#{1234.5:.2E}] [#{0.00012:.1e}] [#{0.256:%}] [#{0.256:.1%}] [#{3:.2f}]")
puts("[#{1234567.891:,.2f}] [#{2.5}] [#{2.5:+}] [#{2.5:8}] [#{1.0e20}] [#{-0.0:.1f}]")
s = "hi"
puts("[#{s:<6}] [#{s:>6}] [#{s:^6}] [#{s:*^7}] [#{s:6}] [#{"truncate":.5}] [#{"é":-<3}]")
puts("[#{true:>6}] [#{nil:5}] [#{[1, 2]:>8}] [#{(1, "a"):s}] [#{s:s}] [#{42:s}]")
puts("[#{2 ** 80:,}] [#{-(2 ** 70):x}] [#{2 ** 64:#b}]")
puts("[#{n::^11}] [#{n:.^11}] [#{n:0^11}]")
# Expressions with brackets, calls and named arguments still parse before the spec.
xs = [1.5, 2.25]
dict = ["k": 7]
puts("[#{xs[1]:.1f}] [#{dict["k"]:03}] [#{xs.map { |x| x * 2 }.length:>3}] [#{"a,b".split(","):>12}]")
# Dyn values are checked when formatted.
d: Dyn = 3.5
e: Dyn = 255
puts("[#{d:6.2f}] [#{e:x}] [#{e:.1f}]")
# A generic value is formatted by its runtime type.
fn cell[T](v: T) -> String { "|#{v:>6}|" }
puts(cell(12) + cell("ab") + cell(1.5))

# Runtime templates.
puts("{} + {} = {:.2f}".format([1, 2.5, 3.5]))
puts("{:>6}|{:<6}|{:^6}|".format(["a", "b", "c"]))
puts("{{literal}} {:,} {}".format([1000000, nil]))
puts("no placeholders".format([]))

# Int.to_s with a base.
puts(255.to_s(16))
puts((-10).to_s(2))
puts(35.to_s(36))
puts(1234.to_s)
puts((2 ** 70).to_s(16))
