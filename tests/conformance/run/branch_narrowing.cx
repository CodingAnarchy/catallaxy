# Each branch of an `if` or `match` starts from the narrowings before it, so an assignment in one
# branch does not reach the others. After it, a variable stays narrowed when every branch that
# falls through leaves it narrowed.
fn pick(c: Bool) -> Int {
  x: Int? = 1
  if x == nil { return 0 }
  if c {
    x = nil
    0
  } else {
    x + 1
  }
}

fn arms(n: Int) -> Int {
  x: Int? = 10
  if x == nil { return 0 }
  match n {
    0 => {
      x = nil
      return -1
    }
    1 => puts(x + 1)
    _ => {}
  }
  x + n
}

fn default(o: Int?, c: Bool) -> Int {
  y = o
  if y == nil { y = 5 }
  z = o
  if c { z = 1 } else if z == nil { z = 2 }
  y + z
}

puts(pick(true))
puts(pick(false))
puts(arms(0))
puts(arms(1))
puts(arms(2))
puts(default(nil, false))
puts(default(3, false))
puts(default(nil, true))
