# Parked fibers keep their objects alive across collections, minor and major.
fs = (0...200).map { |k|
  Fiber.start {
    mine = (0...50).to_list().map { |i| "f#{k}-#{i}" }
    for round in 0...5 {
      junk = (0...200).to_list().map { |i| [i, "tmp#{i}"] }
      Fiber.yield()
      mine.push("r#{round}")
    }
    mine.length + mine[49].length
  }
}
total = 0
for f in fs { total += f.join().unwrap() }
puts(total)
