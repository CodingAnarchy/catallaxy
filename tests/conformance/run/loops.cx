i = 0
while i < 3 {
  i += 1
  if i == 2 { continue }
  print(i)
}
puts()
n = loop {
  i += 10
  if i > 50 { break i }
}
puts(n)
outer = 0
for a in 1..3 {
  for b in 1..3 {
    if b == 2 { break }
    outer += a * b
  }
}
puts(outer)
k = 0
for x in [10, 20, 30] {
  if x == 20 { continue }
  k += x
}
puts(k)
count = 0
5.times { |_| count += 1 }
puts(count)
1.upto(3) { |v| print(v) }
puts()
3.downto(1) { |v| print(v) }
puts()
for c in "abc" { print(c.upcase) }
puts()
for e in Set.from([3]) { puts(e) }
result = if count > 3 { "big" } else { "small" }
puts(result)
fn greet(name: String, greeting: String = "Hello", punct: String = "!") -> String {
  "#{greeting}, #{name}#{punct}"
}
puts(greet("Ann"))
puts(greet("Bo", "Hi"))
puts(greet("Cy", punct: "?"))
puts(greet(punct: ".", name: "Di"))
