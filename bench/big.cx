class Item0 {
  name: String
  qty: Int
  price: Float = 1.0
  fn total(self) -> Float { self.qty.to_f * self.price }
  fn label(self) -> String { "#{self.name} x#{self.qty}" }
}

fn process0(items: List[Item0]) -> Dict[String, Float] {
  out: Dict[String, Float] = [:]
  for it in items {
    if it.qty > 0 {
      out[it.label()] = it.total()
    }
  }
  big = items.select { |x| x.total() > 10.0 }.map { |x| x.name }
  puts(big.join(", "))
  out
}

