class Tree {
  left: Tree?
  right: Tree?
}
fn make(d: Int) -> Tree {
  if d == 0 { Tree.new(nil, nil) } else { Tree.new(make(d - 1), make(d - 1)) }
}
fn check(t: Tree) -> Int {
  l = t.left
  r = t.right
  if l == nil or r == nil { 1 } else { 1 + check(l) + check(r) }
}
total = 0
for i in 0...20 { total += check(make(16)) }
puts(total)
