# 10,000 fibers doing channel, sleep and file work on one OS thread (plus the I/O pool).
path = "/tmp/catx_fibers_bench.txt"
File.write(path, "x" * 1000).unwrap()
results: Channel[Int] = Channel.new()
fs = (1..10000).map { |i|
  Fiber.start {
    sleep(0.01 * (i % 5))
    n = if i % 10 == 0 { File.read(path).unwrap().length } else { i % 7 }
    results.send(n)
    n
  }
}
collector = Fiber.start {
  got = 0
  for k in 0...10000 { got += results.recv() ?? 0 }
  got
}
total = 0
for f in fs { total += f.join().unwrap() }
puts(total == collector.join().unwrap())
puts(total)
File.delete(path).unwrap()
