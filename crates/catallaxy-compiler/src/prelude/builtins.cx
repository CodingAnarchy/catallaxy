# Methods of builtin types.

pub enum Result[T, E] {
  Ok(T)
  Err(E)

  fn is_ok(self) -> Bool { match self { Ok(_) => true, Err(_) => false } }
  fn is_err(self) -> Bool { not self.is_ok() }
  fn ok(self) -> T? { match self { Ok(v) => v, Err(_) => nil } }
  fn err(self) -> E? { match self { Ok(_) => nil, Err(e) => e } }
  fn unwrap(self) -> T {
    match self {
      Ok(v) => v
      Err(e) => panic("called unwrap on Err: #{e}")
    }
  }
  fn unwrap_err(self) -> E {
    match self {
      Ok(v) => panic("called unwrap_err on Ok: #{v}")
      Err(e) => e
    }
  }
  fn expect(self, message: String) -> T {
    match self {
      Ok(v) => v
      Err(e) => panic("#{message}: #{e}")
    }
  }
  fn unwrap_or(self, default: T) -> T { match self { Ok(v) => v, Err(_) => default } }
  fn unwrap_or_else(self, f: fn(E) -> T) -> T { match self { Ok(v) => v, Err(e) => f(e) } }
  fn map[U](self, f: fn(T) -> U) -> Result[U, E] { match self { Ok(v) => Ok(f(v)), Err(e) => Err(e) } }
  fn map_err[F](self, f: fn(E) -> F) -> Result[T, F] { match self { Ok(v) => Ok(v), Err(e) => Err(f(e)) } }
  fn and_then[U](self, f: fn(T) -> Result[U, E]) -> Result[U, E] { match self { Ok(v) => f(v), Err(e) => Err(e) } }
}

extend Int {
  # Digits in `base` (2 to 36, lowercase letters above 9), with a leading `-` if negative.
  native fn to_s(self, base: Int = 10) -> String
  native fn hash(self) -> Int
  fn <=>(self, other: Int) -> Int { if self < other { -1 } else if self > other { 1 } else { 0 } }
  native fn to_f(self) -> Float
  fn to_i(self) -> Int { self }
  fn abs(self) -> Int { if self < 0 { -self } else { self } }
  fn sign(self) -> Int { if self < 0 { -1 } else if self > 0 { 1 } else { 0 } }
  fn is_even(self) -> Bool { self % 2 == 0 }
  fn is_odd(self) -> Bool { self % 2 != 0 }
  fn is_zero(self) -> Bool { self == 0 }
  fn succ(self) -> Int { self + 1 }
  fn pred(self) -> Int { self - 1 }
  fn min(self, other: Int) -> Int { if self < other { self } else { other } }
  fn max(self, other: Int) -> Int { if self > other { self } else { other } }
  fn times(self, f: fn(Int)) {
    i = 0
    while i < self {
      f(i)
      i += 1
    }
  }
  fn upto(self, limit: Int, f: fn(Int)) {
    i = self
    while i <= limit {
      f(i)
      i += 1
    }
  }
  fn downto(self, limit: Int, f: fn(Int)) {
    i = self
    while i >= limit {
      f(i)
      i -= 1
    }
  }
  fn gcd(self, other: Int) -> Int {
    a = self.abs
    b = other.abs
    while b != 0 {
      t = b
      b = a % b
      a = t
    }
    a
  }
  fn lcm(self, other: Int) -> Int {
    if self == 0 or other == 0 { return 0 }
    (self / self.gcd(other) * other).abs
  }
  fn pow(self, exp: Int) -> Int { self ** exp }
  native fn to_s_radix(self, radix: Int) -> String
  native fn chr(self) -> String
  native fn sqrt(self) -> Int
  fn digits(self) -> List[Int] {
    n = self.abs
    out: List[Int] = []
    if n == 0 { return [0] }
    while n > 0 {
      out.push(n % 10)
      n = n / 10
    }
    out
  }
  native fn bit_length(self) -> Int
}

extend Float {
  native fn to_s(self) -> String
  native fn hash(self) -> Int
  fn <=>(self, other: Float) -> Int { if self < other { -1 } else if self > other { 1 } else { 0 } }
  fn to_f(self) -> Float { self }
  native fn to_i(self) -> Int
  native fn floor(self) -> Int
  native fn ceil(self) -> Int
  native fn round(self) -> Int
  native fn round_to(self, digits: Int) -> Float
  native fn truncate(self) -> Int
  fn abs(self) -> Float { if self < 0.0 { -self } else { self } }
  native fn sqrt(self) -> Float
  native fn cbrt(self) -> Float
  native fn sin(self) -> Float
  native fn cos(self) -> Float
  native fn tan(self) -> Float
  native fn asin(self) -> Float
  native fn acos(self) -> Float
  native fn atan(self) -> Float
  native fn atan2(self, x: Float) -> Float
  native fn exp(self) -> Float
  native fn ln(self) -> Float
  native fn log10(self) -> Float
  native fn log2(self) -> Float
  native fn is_nan(self) -> Bool
  native fn is_infinite(self) -> Bool
  native fn is_finite(self) -> Bool
  fn min(self, other: Float) -> Float { if self < other { self } else { other } }
  fn max(self, other: Float) -> Float { if self > other { self } else { other } }
  native fn format(self, decimals: Int) -> String
}

extend Bool {
  native fn to_s(self) -> String
  native fn hash(self) -> Int
}

extend Nil {
  fn to_s(self) -> String { "nil" }
}

extend String {
  native fn to_s(self) -> String
  native fn hash(self) -> Int
  native fn <=>(self, other: String) -> Int
  native fn +(self, other: String) -> String
  native fn *(self, times: Int) -> String
  native fn [](self, index: Int) -> String
  native fn length(self) -> Int
  native fn byte_length(self) -> Int
  fn size(self) -> Int { self.length }
  fn is_empty(self) -> Bool { self.byte_length == 0 }
  native fn upcase(self) -> String
  native fn downcase(self) -> String
  native fn capitalize(self) -> String
  native fn swapcase(self) -> String
  native fn reverse(self) -> String
  native fn strip(self) -> String
  native fn lstrip(self) -> String
  native fn rstrip(self) -> String
  fn trim(self) -> String { self.strip }
  native fn chomp(self) -> String
  native fn split(self, sep: String = "") -> List[String]
  native fn lines(self) -> List[String]
  native fn chars(self) -> List[String]
  native fn bytes(self) -> List[Int]
  # The UTF-8 encoding as `Bytes`.
  native fn to_bytes(self) -> Bytes
  # Decodes UTF-8, or returns why the bytes are not valid UTF-8.
  native fn from_bytes(bytes: Bytes) -> Result[String, String]
  # Decodes UTF-8, replacing invalid sequences with U+FFFD.
  native fn from_bytes_lossy(bytes: Bytes) -> String
  native fn starts_with(self, prefix: String) -> Bool
  native fn ends_with(self, suffix: String) -> Bool
  native fn contains(self, sub: String) -> Bool
  fn include(self, sub: String) -> Bool { self.contains(sub) }
  native fn index_of(self, sub: String, from: Int = 0) -> Int?
  native fn rindex_of(self, sub: String) -> Int?
  native fn replace(self, old: String, new: String) -> String
  native fn replace_first(self, old: String, new: String) -> String
  native fn slice(self, start: Int, len: Int) -> String
  native fn substring(self, start: Int, end: Int) -> String
  native fn count(self, sub: String) -> Int
  native fn to_i(self) -> Int?
  native fn to_f(self) -> Float?
  native fn parse_int(self, radix: Int = 10) -> Int?
  native fn ord(self) -> Int
  native fn center(self, width: Int, pad: String = " ") -> String
  native fn ljust(self, width: Int, pad: String = " ") -> String
  native fn rjust(self, width: Int, pad: String = " ") -> String
  # Fills a runtime template: `{}` takes the next argument's `to_s`, `{:spec}` formats it with a
  # spec as in `"#{x:spec}"`, `{{` and `}}` are literal braces. Panics with a `FormatError` on a bad
  # spec or when the placeholders and arguments do not match in number.
  native fn format(self, args: List[Dyn]) -> String
  native fn is_digit(self) -> Bool
  native fn is_alpha(self) -> Bool
  native fn is_alnum(self) -> Bool
  native fn is_space(self) -> Bool
  native fn is_upper(self) -> Bool
  native fn is_lower(self) -> Bool
  native fn delete_prefix(self, prefix: String) -> String
  native fn delete_suffix(self, suffix: String) -> String
  native fn squeeze(self) -> String
  native fn tr(self, from: String, to: String) -> String
  fn each_char(self, f: fn(String)) {
    for c in self.chars { f(c) }
  }
  fn repeat(self, n: Int) -> String { self * n }
  # Regex conveniences: `re.matches(self)`, the texts of `re.find_all(self)`, `re.replace(self, r)`
  # and `re.replace_all(self, r)`.
  fn matches(self, re: Regex) -> Bool { re.matches(self) }
  fn scan(self, re: Regex) -> List[String] { re.find_all(self).map { |m| m.text } }
  fn sub(self, re: Regex, replacement: String) -> String { re.replace(self, replacement) }
  fn gsub(self, re: Regex, replacement: String) -> String { re.replace_all(self, replacement) }
}

extend List[T] {
  native fn new() -> List[T]
  # An empty list with room for `n` items. The capacity is a hint: at most 2^24 items are
  # reserved up front, and the list grows past that as usual. Panics if `n` is negative.
  native fn with_capacity(n: Int) -> List[T]
  # `n` copies of `value`. Panics with a MemoryError if the list cannot fit in memory.
  native fn filled(n: Int, value: T) -> List[T]
  native fn length(self) -> Int
  fn size(self) -> Int { self.length }
  fn is_empty(self) -> Bool { self.length == 0 }
  native fn push(mut self, item: T)
  fn append(mut self, item: T) { self.push(item) }
  native fn pop(mut self) -> T?
  native fn shift(mut self) -> T?
  native fn unshift(mut self, item: T)
  native fn insert(mut self, index: Int, item: T)
  native fn remove_at(mut self, index: Int) -> T
  native fn clear(mut self)
  native fn concat(mut self, other: List[T])
  native fn [](self, index: Int) -> T
  native fn []=(mut self, index: Int, value: T)
  native fn get(self, index: Int) -> T?
  native fn slice(self, start: Int, len: Int) -> List[T]
  native fn dup(self) -> List[T]
  native fn reverse(self) -> List[T]
  native fn reverse_in_place(mut self)
  native fn swap(mut self, i: Int, j: Int)
  native fn truncate(mut self, len: Int)
  fn +(self, other: List[T]) -> List[T] {
    out = self.dup()
    out.concat(other)
    out
  }
  fn first(self) -> T? { self.get(0) }
  fn last(self) -> T? { self.get(-1) }
  fn each(self, f: fn(T)) {
    i = 0
    while i < self.length {
      f(self[i])
      i += 1
    }
  }
  fn each_with_index(self, f: fn(T, Int)) {
    i = 0
    while i < self.length {
      f(self[i], i)
      i += 1
    }
  }
  fn each_index(self, f: fn(Int)) {
    i = 0
    while i < self.length {
      f(i)
      i += 1
    }
  }
  fn map[U](self, f: fn(T) -> U) -> List[U] {
    n = self.length
    out: List[U] = List.with_capacity(n)
    i = 0
    while i < n {
      out.push(f(self[i]))
      i += 1
    }
    out
  }
  fn map_with_index[U](self, f: fn(T, Int) -> U) -> List[U] {
    out: List[U] = List.with_capacity(self.length)
    i = 0
    while i < self.length {
      out.push(f(self[i], i))
      i += 1
    }
    out
  }
  fn select(self, f: fn(T) -> Bool) -> List[T] {
    out: List[T] = []
    i = 0
    while i < self.length {
      x = self[i]
      if f(x) { out.push(x) }
      i += 1
    }
    out
  }
  fn reject(self, f: fn(T) -> Bool) -> List[T] {
    out: List[T] = []
    i = 0
    while i < self.length {
      x = self[i]
      if not f(x) { out.push(x) }
      i += 1
    }
    out
  }
  fn reduce[U](self, init: U, f: fn(U, T) -> U) -> U {
    acc = init
    i = 0
    while i < self.length {
      acc = f(acc, self[i])
      i += 1
    }
    acc
  }
  fn index_of(self, item: T) -> Int? {
    i = 0
    while i < self.length {
      if self[i] == item { return i }
      i += 1
    }
    nil
  }
  fn contains(self, item: T) -> Bool { self.index_of(item) != nil }
  fn delete(mut self, item: T) -> Bool {
    if let i = self.index_of(item) {
      self.remove_at(i)
      return true
    }
    false
  }
  fn delete_if(mut self, f: fn(T) -> Bool) {
    kept = self.reject(f)
    self.clear()
    self.concat(kept)
  }
  fn fill(mut self, value: T) {
    i = 0
    while i < self.length {
      self[i] = value
      i += 1
    }
  }
  fn rotate(self, n: Int = 1) -> List[T] {
    len = self.length
    if len == 0 { return [] }
    k = n % len
    self.slice(k, len - k) + self.slice(0, k)
  }
  fn chunk(self, size: Int) -> List[List[T]] {
    out: List[List[T]] = []
    i = 0
    while i < self.length {
      out.push(self.slice(i, size))
      i += size
    }
    out
  }
  native fn sort_by_keys[K](self, keys: List[K]) -> List[T]
  native fn sorted(self) -> List[T]
  native fn sort_in_place(mut self)
  fn sort_with(self, f: fn(T, T) -> Int) -> List[T] {
    # Merge sort using the comparator.
    if self.length <= 1 { return self.dup() }
    mid = self.length / 2
    left = self.slice(0, mid).sort_with(f)
    right = self.slice(mid, self.length - mid).sort_with(f)
    out: List[T] = List.with_capacity(self.length)
    i = 0
    j = 0
    while i < left.length and j < right.length {
      if f(left[i], right[j]) <= 0 {
        out.push(left[i])
        i += 1
      } else {
        out.push(right[j])
        j += 1
      }
    }
    while i < left.length {
      out.push(left[i])
      i += 1
    }
    while j < right.length {
      out.push(right[j])
      j += 1
    }
    out
  }
  native fn par_map[U](self, f: fn(T) -> U) -> List[U]
  native fn par_each(self, f: fn(T))
  native fn par_reduce(self, identity: T, f: fn(T, T) -> T) -> T
  native fn par_select(self, f: fn(T) -> Bool) -> List[T]
}

extend List[List[U]] {
  fn flatten(self) -> List[U] {
    out: List[U] = []
    for xs in self { out.concat(xs) }
    out
  }
}

# A double-ended queue: a growable ring buffer with O(1) amortized `push`/`pop` at the back,
# `unshift`/`shift` at the front, and O(1) indexing (negative indices count from the end). Use it
# instead of `List.shift`/`unshift`, which move every item. Ownership is as for `List`: a deque is
# owned by one thread, `freeze` makes it (and its items) immutable and shareable, and `Mutex`
# shares a mutable one. It is `Enumerable`; `==` compares items in order and `Json.stringify`
# writes it as an array.
pub class Deque[T] {
  # Internal: the ring (its length is the capacity; vacant slots hold nil), the index of the
  # first item and the item count.
  _buf: List[T]
  _head: Int
  _len: Int
  fn init(self) {
    self._buf = []
    self._head = 0
    self._len = 0
  }
  fn from(items: Enumerable[T]) -> Deque[T] {
    d: Deque[T] = Deque.new()
    items.each { |x| d.push(x) }
    d
  }
  fn length(self) -> Int { self._len }
  fn size(self) -> Int { self._len }
  fn is_empty(self) -> Bool { self._len == 0 }
  # Appends at the back.
  fn push(self, item: T) {
    if self._len == self._buf.length { self._grow() }
    j = self._head + self._len
    if j >= self._buf.length { j -= self._buf.length }
    self._buf[j] = item
    self._len += 1
  }
  # Removes and returns the last item.
  fn pop(self) -> T? {
    if self._len == 0 { return nil }
    j = self._head + self._len - 1
    if j >= self._buf.length { j -= self._buf.length }
    x = self._buf[j]
    self._buf[j] = __vacant(self._buf)
    self._len -= 1
    x
  }
  # Prepends at the front.
  fn unshift(self, item: T) {
    if self._len == self._buf.length { self._grow() }
    h = self._head - 1
    if h < 0 { h += self._buf.length }
    self._buf[h] = item
    self._head = h
    self._len += 1
  }
  # Removes and returns the first item.
  fn shift(self) -> T? {
    if self._len == 0 { return nil }
    h = self._head
    x = self._buf[h]
    self._buf[h] = __vacant(self._buf)
    h += 1
    self._head = if h == self._buf.length { 0 } else { h }
    self._len -= 1
    x
  }
  fn first(self) -> T? { self.get(0) }
  fn last(self) -> T? { self.get(-1) }
  fn [](self, index: Int) -> T {
    i = if index < 0 { index + self._len } else { index }
    if i < 0 or i >= self._len { panic("IndexError: index #{index} out of range for length #{self._len}") }
    j = self._head + i
    if j >= self._buf.length { j -= self._buf.length }
    self._buf[j]
  }
  fn []=(self, index: Int, value: T) {
    i = if index < 0 { index + self._len } else { index }
    if i < 0 or i >= self._len { panic("IndexError: index #{index} out of range for length #{self._len}") }
    j = self._head + i
    if j >= self._buf.length { j -= self._buf.length }
    self._buf[j] = value
  }
  fn get(self, index: Int) -> T? {
    i = if index < 0 { index + self._len } else { index }
    if i < 0 or i >= self._len { return nil }
    j = self._head + i
    if j >= self._buf.length { j -= self._buf.length }
    self._buf[j]
  }
  fn clear(self) {
    self._buf = []
    self._head = 0
    self._len = 0
  }
  fn each(self, f: fn(T)) {
    i = 0
    while i < self._len {
      j = self._head + i
      if j >= self._buf.length { j -= self._buf.length }
      f(self._buf[j])
      i += 1
    }
  }
  fn to_list(self) -> List[T] {
    out: List[T] = List.with_capacity(self._len)
    self.each { |x| out.push(x) }
    out
  }
  fn dup(self) -> Deque[T] { Deque.from(self) }
  fn ==(self, other: Deque[T]) -> Bool { self.to_list() == other.to_list() }
  fn hash(self) -> Int { __hash_of(self.to_list()) }
  fn to_s(self) -> String { "Deque#{inspect(self.to_list())}" }
  fn inspect(self) -> String { self.to_s }
  fn to_json(self) -> Dyn { self.to_list() }
  # Doubles the capacity, moving the items to the start of a new ring.
  fn _grow(self) {
    cap = self._buf.length
    ncap = if cap < 8 { 8 } else { cap * 2 }
    nb: List[T] = List.with_capacity(ncap)
    i = 0
    while i < self._len {
      j = self._head + i
      if j >= cap { j -= cap }
      nb.push(self._buf[j])
      i += 1
    }
    hole = __vacant(nb)
    while i < ncap {
      nb.push(hole)
      i += 1
    }
    self._buf = nb
    self._head = 0
  }
}

# Internal: the filler for vacant ring slots (nil, whatever the element type).
native fn __vacant[T](witness: List[T]) -> T
# Internal: the structural hash `Dict` and `Set` use for any value.
native fn __hash_of(value: Dyn) -> Int

extend Dict[K, V] {
  native fn new() -> Dict[K, V]
  native fn length(self) -> Int
  fn size(self) -> Int { self.length }
  fn is_empty(self) -> Bool { self.length == 0 }
  native fn [](self, key: K) -> V?
  native fn []=(mut self, key: K, value: V)
  native fn get(self, key: K) -> V?
  fn fetch(self, key: K, default: V) -> V { self.get(key) ?? default }
  native fn has_key(self, key: K) -> Bool
  fn contains_key(self, key: K) -> Bool { self.has_key(key) }
  native fn delete(mut self, key: K) -> V?
  native fn clear(mut self)
  native fn keys(self) -> List[K]
  native fn values(self) -> List[V]
  native fn entries(self) -> List[(K, V)]
  native fn dup(self) -> Dict[K, V]
  fn each(self, f: fn((K, V))) {
    for e in self.entries() { f(e) }
  }
  fn each_key(self, f: fn(K)) { for k in self.keys() { f(k) } }
  fn each_value(self, f: fn(V)) { for v in self.values() { f(v) } }
  fn get_or_insert(mut self, key: K, default: V) -> V {
    if let v = self.get(key) { return v }
    self[key] = default
    default
  }
  fn merge(self, other: Dict[K, V]) -> Dict[K, V] {
    out = self.dup()
    for (k, v) in other.entries() { out[k] = v }
    out
  }
  fn update(mut self, other: Dict[K, V]) {
    for (k, v) in other.entries() { self[k] = v }
  }
  fn map_values[W](self, f: fn(V) -> W) -> Dict[K, W] {
    out: Dict[K, W] = [:]
    for (k, v) in self.entries() { out[k] = f(v) }
    out
  }
  fn select_entries(self, f: fn(K, V) -> Bool) -> Dict[K, V] {
    out: Dict[K, V] = [:]
    for (k, v) in self.entries() { if f(k, v) { out[k] = v } }
    out
  }
  fn invert(self) -> Dict[V, K] {
    out: Dict[V, K] = [:]
    for (k, v) in self.entries() { out[v] = k }
    out
  }
  fn sort_by_value(self) -> List[(K, V)] {
    self.entries().sort_by { |e| e.1 }
  }
  fn sort_by_key(self) -> List[(K, V)] {
    self.entries().sort_by { |e| e.0 }
  }
}

extend Set[T] {
  native fn new() -> Set[T]
  native fn from(items: List[T]) -> Set[T]
  native fn length(self) -> Int
  fn size(self) -> Int { self.length }
  fn is_empty(self) -> Bool { self.length == 0 }
  native fn add(mut self, item: T) -> Bool
  native fn remove(mut self, item: T) -> Bool
  native fn contains(self, item: T) -> Bool
  native fn clear(mut self)
  native fn to_list(self) -> List[T]
  native fn dup(self) -> Set[T]
  fn each(self, f: fn(T)) { for x in self.to_list() { f(x) } }
  fn union(self, other: Set[T]) -> Set[T] {
    out = self.dup()
    for x in other.to_list() { out.add(x) }
    out
  }
  fn intersection(self, other: Set[T]) -> Set[T] {
    out: Set[T] = Set.new()
    for x in self.to_list() { if other.contains(x) { out.add(x) } }
    out
  }
  fn difference(self, other: Set[T]) -> Set[T] {
    out: Set[T] = Set.new()
    for x in self.to_list() { if not other.contains(x) { out.add(x) } }
    out
  }
  fn |(self, other: Set[T]) -> Set[T] { self.union(other) }
  fn &(self, other: Set[T]) -> Set[T] { self.intersection(other) }
  fn -(self, other: Set[T]) -> Set[T] { self.difference(other) }
  fn is_subset(self, other: Set[T]) -> Bool { self.all { |x| other.contains(x) } }
  fn is_superset(self, other: Set[T]) -> Bool { other.is_subset(self) }
}

extend Range {
  native fn first(self) -> Int
  native fn last(self) -> Int
  native fn is_exclusive(self) -> Bool
  fn each(self, f: fn(Int)) {
    i = self.first
    stop = if self.is_exclusive { self.last } else { self.last + 1 }
    while i < stop {
      f(i)
      i += 1
    }
  }
  fn length(self) -> Int {
    n = if self.is_exclusive { self.last - self.first } else { self.last - self.first + 1 }
    n.max(0)
  }
  fn size(self) -> Int { self.length }
  fn contains(self, x: Int) -> Bool {
    if self.is_exclusive { x >= self.first and x < self.last } else { x >= self.first and x <= self.last }
  }
  fn step(self, n: Int) -> List[Int] {
    out: List[Int] = []
    i = self.first
    stop = if self.is_exclusive { self.last } else { self.last + 1 }
    while i < stop {
      out.push(i)
      i += n
    }
    out
  }
  fn to_list(self) -> List[Int] {
    out: List[Int] = List.with_capacity(self.length)
    for i in self { out.push(i) }
    out
  }
  fn sum(self) -> Int {
    total = 0
    for i in self { total += i }
    total
  }
}

extend StringBuilder {
  native fn new() -> StringBuilder
  native fn push(mut self, s: String)
  native fn push_value(mut self, v: Dyn)
  native fn push_char(mut self, code: Int)
  native fn to_s(self) -> String
  native fn length(self) -> Int
  native fn clear(mut self)
}

extend Mutex[T] {
  native fn new(move value: T) -> Mutex[T]
  native fn lock[R](self, f: fn(T) -> R) -> R
  native fn update(self, f: fn(T) -> T) -> T
  native fn get(self) -> T
  native fn set(self, move value: T)
}

extend Atomic[T] {
  native fn new(value: T) -> Atomic[T]
  native fn get(self) -> T
  native fn set(self, value: T)
  native fn swap(self, value: T) -> T
  native fn compare_and_set(self, expected: T, value: T) -> Bool
  native fn add(self, delta: Int) -> Int
  native fn update(self, f: fn(T) -> T) -> T
}

extend Channel[T] {
  native fn new(capacity: Int = 0) -> Channel[T]
  native fn send(self, move item: T)
  native fn recv(self) -> T?
  native fn try_recv(self) -> T?
  native fn close(self)
  native fn is_closed(self) -> Bool
  native fn length(self) -> Int
  fn each(self, f: fn(T)) {
    loop {
      if let x = self.recv() { f(x) } else { break }
    }
  }
}

extend Thread[T] {
  native fn join(self) -> Result[T, String]
  native fn is_done(self) -> Bool
}

# A fiber: a lightweight cooperative thread for I/O-bound work. It runs on the OS thread that
# spawned it, interleaving with that thread's other fibers wherever one waits (channels, `join`,
# `sleep`, file and console I/O, `Fiber.yield`), so its block may capture owned values. A thread
# finishes only after its fibers do.
pub class Fiber[T] {
  id: Int
  # Internal: the result, stored in the handle so it lives exactly as long as the handle. Read it
  # with `join`. (The runtime addresses fields by position: `id` is 0, this is 1.)
  _result: T?
  fn start(f: fn() -> T) -> Fiber[T] {
    h: Fiber[T] = Fiber.new(0, nil)
    __fiber_spawn(h, f)
    h
  }
  # Waits for the fiber and returns its result, or the message of the panic that ended it.
  fn join(self) -> Result[T, String] { __fiber_join(self) }
  fn is_done(self) -> Bool { __fiber_done(self.id) }
  # Lets the thread's other fibers run.
  fn yield() { __fiber_yield() }
}

native fn __fiber_spawn[T](handle: Fiber[T], f: fn() -> T)
native fn __fiber_join[T](handle: Fiber[T]) -> Result[T, String]
native fn __fiber_done(id: Int) -> Bool
native fn __fiber_yield()

# ---------------------------------------------------------------------------------------------
# Namespaces

pub class Math {
  const PI: Float = 3.141592653589793
  const E: Float = 2.718281828459045
  const INFINITY: Float = 1.0 / 0.0
  native fn sqrt(x: Float) -> Float
  native fn pow(x: Float, y: Float) -> Float
  native fn sin(x: Float) -> Float
  native fn cos(x: Float) -> Float
  native fn tan(x: Float) -> Float
  native fn atan2(y: Float, x: Float) -> Float
  native fn exp(x: Float) -> Float
  native fn log(x: Float) -> Float
  native fn log10(x: Float) -> Float
  native fn hypot(x: Float, y: Float) -> Float
  fn min_int(a: Int, b: Int) -> Int { if a < b { a } else { b } }
  fn max_int(a: Int, b: Int) -> Int { if a > b { a } else { b } }
}

pub class File {
  native fn read(path: String) -> Result[String, String]
  native fn write(path: String, contents: String) -> Result[Nil, String]
  native fn append(path: String, contents: String) -> Result[Nil, String]
  native fn exists(path: String) -> Bool
  native fn delete(path: String) -> Result[Nil, String]
  native fn read_lines(path: String) -> Result[List[String], String]
  native fn list_dir(path: String) -> Result[List[String], String]
  native fn metadata(path: String) -> Result[Metadata, String]
  # The file's contents as they are, for binary files (`read` needs valid UTF-8).
  native fn read_bytes(path: String) -> Result[Bytes, String]
  native fn write_bytes(path: String, data: Bytes) -> Result[Nil, String]
}

# An immutable byte string. Like `String` it is frozen, so it is shared freely between threads
# and fibers; build one from a list of byte values, from text (`s.to_bytes`), from hex or base64,
# or by reading a file (`File.read_bytes`). To assemble bytes piece by piece, collect them in a
# `List[Int]` and convert once with `Bytes.new`, or join pieces with `+`.
pub frozen class Bytes {
  handle: NativeHandle
  # Bytes with the given values, each in 0..255.
  native fn new(values: List[Int] = []) -> Bytes
  # Parses hex digits (either case, no separators).
  native fn from_hex(text: String) -> Result[Bytes, String]
  # Parses standard base64 (with padding).
  native fn from_base64(text: String) -> Result[Bytes, String]
  native fn length(self) -> Int
  fn size(self) -> Int { self.length }
  fn is_empty(self) -> Bool { self.length == 0 }
  # The byte at `index` (negative counts from the end); panics out of range.
  native fn [](self, index: Int) -> Int
  native fn get(self, index: Int) -> Int?
  native fn slice(self, start: Int, len: Int) -> Bytes
  native fn +(self, other: Bytes) -> Bytes
  native fn ==(self, other: Bytes) -> Bool
  native fn hash(self) -> Int
  native fn to_list(self) -> List[Int]
  fn each(self, f: fn(Int)) {
    i = 0
    n = self.length
    while i < n {
      f(self[i])
      i += 1
    }
  }
  # Lowercase hex, two digits per byte.
  native fn to_hex(self) -> String
  # Standard base64 with padding.
  native fn to_base64(self) -> String
  # `Bytes(` hex `)`. Decode text with `String.from_bytes`.
  native fn to_s(self) -> String
}

# Message digests of text (its UTF-8 bytes) or bytes, as lowercase hex. MD5 and SHA-1 are
# broken for security purposes; use them only for checksums and compatibility.
pub class Digest {
  native fn md5(data: String | Bytes) -> String
  native fn sha1(data: String | Bytes) -> String
  native fn sha256(data: String | Bytes) -> String
  native fn sha512(data: String | Bytes) -> String
}

# Comma-separated values (RFC 4180). A field holding the separator, a quote or a line break is
# quoted, with its quotes doubled. Rows may end with `\n` or `\r\n`; blank lines are skipped. A
# quote inside an unquoted field is kept as text. `sep` must be a single character.
pub class Csv {
  # The rows of `text`, or an error for an unterminated quoted field or text after one.
  native fn parse(text: String, sep: String = ",") -> Result[List[List[String]], String]
  # The rows after the first as dicts keyed by the first (header) row's fields. A row with
  # fewer fields lacks the missing keys; one with more fields is an error.
  fn parse_records(text: String, sep: String = ",") -> Result[List[Dict[String, String]], String] {
    rows = Csv.parse(text, sep)?
    out: List[Dict[String, String]] = []
    if rows.is_empty() { return Ok(out) }
    header = rows[0]
    i = 1
    while i < rows.length {
      row = rows[i]
      if row.length > header.length {
        return Err("record #{i}: #{row.length} fields, but the header has #{header.length}")
      }
      rec: Dict[String, String] = [:]
      row.each_with_index { |f, j| rec[header[j]] = f }
      out.push(rec)
      i += 1
    }
    Ok(out)
  }
  # Every row followed by `\n`.
  native fn format(rows: List[List[String]], sep: String = ",") -> String
  # One row, without a line ending.
  native fn format_row(row: List[String], sep: String = ",") -> String
  fn read(path: String, sep: String = ",") -> Result[List[List[String]], String] {
    text = File.read(path)?
    Csv.parse(text, sep).map_err { |e| "#{path}: #{e}" }
  }
  fn write(path: String, rows: List[List[String]], sep: String = ",") -> Result[Nil, String] {
    File.write(path, Csv.format(rows, sep))
  }
}

# What `File.metadata` reports. `modified` is in seconds since the Unix epoch, like `Time.now`.
pub class Metadata {
  size: Int
  is_dir: Bool
  is_file: Bool
  modified: Float
}

pub class Dir {
  # Entry names (not paths), sorted.
  native fn list(path: String) -> Result[List[String], String]
  # With `recursive`, creates missing parents too and succeeds if the directory exists.
  native fn create(path: String, recursive: Bool = false) -> Result[Nil, String]
  # Without `recursive` the directory must be empty.
  native fn remove(path: String, recursive: Bool = false) -> Result[Nil, String]
  native fn exists(path: String) -> Bool
  native fn current() -> String
}

# Path strings. `join` uses `/`, which every supported OS accepts; the others accept the host
# separators.
pub class Path {
  # `base/part`, or `part` alone if it is absolute.
  native fn join(base: String, part: String) -> String
  native fn join_all(parts: List[String]) -> String
  # The last component: `Path.basename("a/b.txt") == "b.txt"`.
  native fn basename(path: String) -> String
  # Everything before the last component, or "." if there is none.
  native fn dirname(path: String) -> String
  # The extension without its dot, or nil: `Path.extension("a/b.tar.gz") == "gz"`.
  native fn extension(path: String) -> String?
  # The last component without its extension.
  native fn stem(path: String) -> String
  native fn is_absolute(path: String) -> Bool
}

# A compiled regular expression, in the syntax of Rust's `regex` crate (no look-around or
# backreferences; matching takes linear time). A Regex is frozen: compile it once and share it
# freely between threads and fibers.
pub frozen class Regex {
  pattern: String
  handle: NativeHandle
  # Compiles `pattern`, or returns the syntax error.
  native fn new(pattern: String) -> Result[Regex, String]
  # `text` with every regex metacharacter escaped.
  native fn escape(text: String) -> String
  native fn matches(self, text: String) -> Bool
  # The leftmost match, or nil.
  native fn find(self, text: String) -> Match?
  # All non-overlapping matches, left to right.
  native fn find_all(self, text: String) -> List[Match]
  # Replaces the first match. In `replacement`, `$1` / `${1}` insert a positional group, `$name` /
  # `${name}` a named one, and `$$` a literal `$`.
  native fn replace(self, text: String, replacement: String) -> String
  native fn replace_all(self, text: String, replacement: String) -> String
  # The pieces of `text` between matches.
  native fn split(self, text: String) -> List[String]
  native fn capture_names(self) -> List[String]
  fn to_s(self) -> String { self.pattern }
}

# One regex match. `start` and `end` are character positions (`end` exclusive), like `String`
# indexing. `groups[0]` is the whole match; a group that did not participate is nil.
pub class Match {
  text: String
  start: Int
  end: Int
  groups: List[String?]
  named_groups: Dict[String, String]
  # Group `index` (0 is the whole match), or nil.
  fn [](self, index: Int) -> String? { self.groups.get(index) ?? nil }
  # The positional groups after the whole match.
  fn captures(self) -> List[String?] { self.groups.drop(1) }
  # A named group, or nil.
  fn named(self, name: String) -> String? { self.named_groups.get(name) }
  fn to_s(self) -> String { self.text }
}

# Running other programs. `cmd` is looked up on the PATH; `args` are passed as they are (no
# shell). `env` adds to (or overrides) the inherited environment; `dir` sets the working
# directory. Waiting parks the calling fiber (the I/O pool waits) instead of blocking its thread.
pub class Process {
  # Runs to completion, feeding it `input` on stdin (or none), and captures its output.
  native fn run(cmd: String, args: List[String] = [], env: Dict[String, String] = [:], dir: String? = nil, input: String? = nil) -> Result[Output, String]
  # Starts a process with piped stdin and stdout (stderr goes to ours).
  native fn start(cmd: String, args: List[String] = [], env: Dict[String, String] = [:], dir: String? = nil) -> Result[Subprocess, String]
}

# The result of `Process.run`. `status` is the exit code, or -1 if a signal ended the process.
pub class Output {
  status: Int
  stdout: String
  stderr: String
  fn success(self) -> Bool { self.status == 0 }
}

# A process started by `Process.start`. Its pipes are locked separately, so one fiber may write
# while another reads.
pub class Subprocess {
  pid: Int
  handle: NativeHandle
  native fn write(self, text: String) -> Result[Nil, String]
  # Sends end-of-file on its stdin.
  native fn close_stdin(self)
  # The next line of its stdout without the line ending, or nil at end of output.
  native fn read_line(self) -> String?
  # The rest of its stdout.
  native fn read_all(self) -> String
  # Closes stdin and waits for the process to exit; returns its status (-1 if a signal ended it).
  native fn wait(self) -> Result[Int, String]
  native fn kill(self) -> Result[Nil, String]
}

# ---------------------------------------------------------------------------------------------
# Time: clocks, `Duration`, `Instant` and `DateTime`.

pub class Time {
  # Seconds since the Unix epoch (1970-01-01T00:00:00Z) on the wall clock.
  native fn now() -> Float
  # Seconds since the program started, on the monotonic clock (which never jumps, unlike the
  # wall clock). `Instant` measures elapsed time with the same clock and nanosecond precision.
  native fn monotonic() -> Float
  # Milliseconds since the Unix epoch on the wall clock. (Before 0.4 it counted from the start of
  # the program; use `Instant` or `Time.monotonic` for that.)
  native fn millis() -> Int
}

native fn __time_wall_nanos() -> Int
native fn __time_mono_nanos() -> Int
native fn __time_local_offset(unix: Int) -> Int

const __NANOS_PER_SEC: Int = 1_000_000_000

# A signed span of time with nanosecond precision: `Duration.from_secs(90)`,
# `Duration.from_millis(250)`, `a.since(b)`. It is frozen, so it crosses threads freely.
# `to_s` writes the units that matter: `1h2m3.5s`, `250ms`, `-1.5µs`, `0s`.
pub frozen class Duration {
  nanos: Int

  fn from_nanos(n: Int) -> Duration { Duration.new(n) }
  fn from_micros(n: Int) -> Duration { Duration.new(n * 1000) }
  fn from_millis(n: Int) -> Duration { Duration.new(n * 1_000_000) }
  fn from_secs(n: Int) -> Duration { Duration.new(n * __NANOS_PER_SEC) }
  fn from_mins(n: Int) -> Duration { Duration.new(n * 60 * __NANOS_PER_SEC) }
  fn from_hours(n: Int) -> Duration { Duration.new(n * 3600 * __NANOS_PER_SEC) }
  fn from_days(n: Int) -> Duration { Duration.new(n * 86400 * __NANOS_PER_SEC) }
  # Rounded to the nearest nanosecond.
  fn from_secs_f(secs: Float) -> Duration { Duration.new((secs * 1000000000.0).round) }

  fn as_nanos(self) -> Int { self.nanos }
  # The whole microseconds, milliseconds or seconds, truncated toward zero.
  fn as_micros(self) -> Int { __time_trunc_div(self.nanos, 1000) }
  fn as_millis(self) -> Int { __time_trunc_div(self.nanos, 1_000_000) }
  fn as_secs(self) -> Int { __time_trunc_div(self.nanos, __NANOS_PER_SEC) }
  fn as_secs_f(self) -> Float { self.nanos.to_f / 1000000000.0 }
  fn is_zero(self) -> Bool { self.nanos == 0 }
  fn is_negative(self) -> Bool { self.nanos < 0 }
  fn abs(self) -> Duration { Duration.new(self.nanos.abs) }
  fn neg(self) -> Duration { Duration.new(-self.nanos) }

  fn +(self, other: Duration) -> Duration { Duration.new(self.nanos + other.nanos) }
  fn -(self, other: Duration) -> Duration { Duration.new(self.nanos - other.nanos) }
  fn *(self, k: Int) -> Duration { Duration.new(self.nanos * k) }
  # Truncates toward zero, to whole nanoseconds.
  fn /(self, k: Int) -> Duration { Duration.new(__time_trunc_div(self.nanos, k)) }
  fn <=>(self, other: Duration) -> Int { self.nanos <=> other.nanos }
  fn ==(self, other: Duration) -> Bool { self.nanos == other.nanos }
  fn hash(self) -> Int { self.nanos.hash }

  fn to_s(self) -> String {
    n = self.nanos
    if n == 0 { return "0s" }
    sign = if n < 0 { "-" } else { "" }
    n = n.abs
    if n < 1000 { return "#{sign}#{n}ns" }
    if n < 1_000_000 { return "#{sign}#{__time_decimal(n, 1000)}µs" }
    if n < __NANOS_PER_SEC { return "#{sign}#{__time_decimal(n, 1_000_000)}ms" }
    sb = StringBuilder.new()
    sb.push(sign)
    h = n / (3600 * __NANOS_PER_SEC)
    m = n / (60 * __NANOS_PER_SEC) % 60
    if h > 0 { sb.push("#{h}h") }
    if h > 0 or m > 0 { sb.push("#{m}m") }
    sb.push(__time_decimal(n % (60 * __NANOS_PER_SEC), __NANOS_PER_SEC))
    sb.push("s")
    sb.to_s
  }
}

# A reading of the monotonic clock, for measuring elapsed time:
# `start = Instant.now(); work(); puts(start.elapsed())`. Frozen.
pub frozen class Instant {
  # Nanoseconds since the program started.
  nanos: Int

  fn now() -> Instant { Instant.new(__time_mono_nanos()) }
  # The time since this instant.
  fn elapsed(self) -> Duration { Instant.now().since(self) }
  # `self - earlier`, negative if `earlier` is later.
  fn since(self, earlier: Instant) -> Duration { Duration.new(self.nanos - earlier.nanos) }
  fn +(self, d: Duration) -> Instant { Instant.new(self.nanos + d.nanos) }
  fn -(self, d: Duration) -> Instant { Instant.new(self.nanos - d.nanos) }
  fn <=>(self, other: Instant) -> Int { self.nanos <=> other.nanos }
  fn ==(self, other: Instant) -> Bool { self.nanos == other.nanos }
  fn hash(self) -> Int { self.nanos.hash }
}

# A point in time with a fixed offset from UTC, read on the proleptic Gregorian calendar. Two
# DateTimes are equal (and compare) by the instant they denote, whatever their offsets. Frozen.
#
#   t = DateTime.of(2024, 2, 29, 13, 5, offset: 3600)   # 2024-02-29T13:05:00+01:00
#   t.year; t.month; t.day; t.hour; t.weekday           # 2024, 2, 29, 13, 4 (Thursday)
#   (t + Duration.from_days(1)).to_s                    # "2024-03-01T13:05:00+01:00"
#   t.to_utc().format("%a %d %b %Y %H:%M %Z")            # "Thu 29 Feb 2024 12:05 UTC"
#   DateTime.parse("2024-02-29T12:05:00Z")              # Ok(...), equal to t
#
# `DateTime.now()` uses the operating system's current UTC offset (its time zone, including
# daylight saving time); `to_local` converts with the offset in force at that instant. Only the
# offset is kept, not the zone, so adding a Duration never changes the offset.
pub frozen class DateTime {
  # Whole seconds since the Unix epoch (1970-01-01T00:00:00Z); independent of `offset`.
  unix: Int
  # Nanoseconds past `unix`, from 0 to 999_999_999.
  nanosecond: Int
  # Seconds east of UTC: 3600 for +01:00, -18000 for -05:00.
  offset: Int

  # The current time at the operating system's local offset.
  fn now() -> DateTime { DateTime.now_utc().to_local() }
  fn now_utc() -> DateTime {
    n = __time_wall_nanos()
    DateTime.new(n / __NANOS_PER_SEC, n % __NANOS_PER_SEC, 0)
  }
  # The instant `secs` seconds (plus `nanosecond` nanoseconds) after the epoch, at `offset`.
  fn from_unix(secs: Int, nanosecond: Int = 0, offset: Int = 0) -> DateTime {
    __time_check_offset(offset)
    DateTime.new(secs + nanosecond / __NANOS_PER_SEC, nanosecond % __NANOS_PER_SEC, offset)
  }
  fn from_unix_millis(ms: Int, offset: Int = 0) -> DateTime {
    DateTime.from_unix(ms / 1000, nanosecond: ms % 1000 * 1_000_000, offset: offset)
  }
  # The given civil date and time at `offset` (seconds east of UTC). Panics if a field is out of
  # range (`month` 1-12, `day` within the month, `hour` 0-23, `minute` and `second` 0-59,
  # `nanosecond` 0-999_999_999, `offset` within ±24 hours).
  fn of(year: Int, month: Int, day: Int, hour: Int = 0, minute: Int = 0, second: Int = 0, nanosecond: Int = 0, offset: Int = 0) -> DateTime {
    if month < 1 or month > 12 or day < 1 or day > __time_days_in_month(year, month) {
      panic("ArgumentError: DateTime.of: invalid date #{year}-#{month}-#{day}")
    }
    if hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 59 {
      panic("ArgumentError: DateTime.of: invalid time #{hour}:#{minute}:#{second}")
    }
    if nanosecond < 0 or nanosecond >= __NANOS_PER_SEC {
      panic("ArgumentError: DateTime.of: nanosecond #{nanosecond} out of range")
    }
    __time_check_offset(offset)
    local = __time_days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
    DateTime.new(local - offset, nanosecond, offset)
  }
  # Parses an ISO 8601 / RFC 3339 date-time: `YYYY-MM-DD`, optionally followed by `T` (or a
  # space) and `HH:MM`, `HH:MM:SS` or `HH:MM:SS.fraction`, then optionally `Z` or an offset
  # `+HH:MM` / `+HHMM` / `+HH`. Without an offset the time is taken as UTC.
  fn parse(text: String) -> Result[DateTime, String] {
    if let t = __time_parse_iso(text.chars) { return Ok(t) }
    Err("invalid date-time #{inspect(text)}: expected ISO 8601 like 2024-05-06T07:08:09Z")
  }

  # The calendar fields, as seen at this DateTime's offset.
  fn year(self) -> Int { __time_civil(self.days()).0 }
  # 1 to 12.
  fn month(self) -> Int { __time_civil(self.days()).1 }
  # 1 to 31.
  fn day(self) -> Int { __time_civil(self.days()).2 }
  fn hour(self) -> Int { self.second_of_day() / 3600 }
  fn minute(self) -> Int { self.second_of_day() / 60 % 60 }
  fn second(self) -> Int { self.second_of_day() % 60 }
  # The day of the week: 0 for Sunday to 6 for Saturday (like `%w`).
  fn weekday(self) -> Int { (self.days() + 4) % 7 }
  # The day of the year: 1 to 366.
  fn yday(self) -> Int {
    d = self.days()
    d - __time_days_from_civil(__time_civil(d).0, 1, 1) + 1
  }
  # Days from 1970-01-01 to this date (at this offset).
  fn days(self) -> Int { (self.unix + self.offset) / 86400 }
  fn second_of_day(self) -> Int { (self.unix + self.offset) % 86400 }
  # Milliseconds since the epoch.
  fn unix_millis(self) -> Int { self.unix * 1000 + self.nanosecond / 1_000_000 }
  # Seconds since the epoch, as a Float (like `Time.now`).
  fn to_f(self) -> Float { self.unix.to_f + self.nanosecond.to_f / 1000000000.0 }

  # The same instant at another offset.
  fn with_offset(self, offset: Int) -> DateTime {
    __time_check_offset(offset)
    DateTime.new(self.unix, self.nanosecond, offset)
  }
  fn to_utc(self) -> DateTime { DateTime.new(self.unix, self.nanosecond, 0) }
  # The same instant at the operating system's local offset for it.
  fn to_local(self) -> DateTime { DateTime.new(self.unix, self.nanosecond, __time_local_offset(self.unix)) }

  fn +(self, d: Duration) -> DateTime {
    n = self.nanosecond + d.nanos
    DateTime.new(self.unix + n / __NANOS_PER_SEC, n % __NANOS_PER_SEC, self.offset)
  }
  fn -(self, d: Duration) -> DateTime { self + d.neg() }
  # `self - earlier`, negative if `earlier` is later.
  fn since(self, earlier: DateTime) -> Duration {
    Duration.new((self.unix - earlier.unix) * __NANOS_PER_SEC + self.nanosecond - earlier.nanosecond)
  }
  fn <=>(self, other: DateTime) -> Int {
    c = self.unix <=> other.unix
    if c != 0 { c } else { self.nanosecond <=> other.nanosecond }
  }
  fn ==(self, other: DateTime) -> Bool { self.unix == other.unix and self.nanosecond == other.nanosecond }
  fn hash(self) -> Int { (self.unix * 1_000_003 + self.nanosecond).hash }

  # RFC 3339 (ISO 8601): `2024-02-29T13:05:00+01:00`, `2024-02-29T12:05:00.25Z`. The fraction
  # appears only when non-zero, without trailing zeros. `DateTime.parse` reads it back.
  fn to_s(self) -> String {
    sb = StringBuilder.new()
    sb.push(self.format("%Y-%m-%dT%H:%M:%S"))
    if self.nanosecond != 0 { sb.push(__time_decimal(self.nanosecond, __NANOS_PER_SEC).delete_prefix("0")) }
    sb.push(if self.offset == 0 { "Z" } else { __time_offset_str(self.offset, ":") })
    sb.to_s
  }

  # Formats with `strftime` directives: `%Y` year (at least 4 digits), `%y` 2-digit year, `%m`
  # month 01-12, `%d` day 01-31, `%e` day padded with a space, `%j` day of the year 001-366, `%H`
  # hour 00-23, `%I` hour 01-12, `%l` hour padded with a space, `%M` minute, `%S` second, `%L`
  # milliseconds, `%f` microseconds, `%N` nanoseconds, `%p` AM/PM, `%P` am/pm, `%a`/`%A`
  # weekday name (`Mon`/`Monday`), `%b`/`%h`/`%B` month name (`Jan`/`January`), `%w` weekday 0-6
  # from Sunday, `%u` weekday 1-7 from Monday, `%s` Unix seconds, `%z` offset `+0100`, `%:z`
  # offset `+01:00`, `%Z` `UTC` or the offset, `%F` = `%Y-%m-%d`, `%T` = `%H:%M:%S`, `%D` =
  # `%m/%d/%y`, `%R` = `%H:%M`, `%c` = `%a %b %e %H:%M:%S %Y`, `%n` newline, `%t` tab, `%%` `%`.
  # Names are English. Other directives are copied through.
  fn format(self, pattern: String) -> String {
    days = self.days()
    sod = self.second_of_day()
    let (y, mo, d) = __time_civil(days)
    h = sod / 3600
    wday = (days + 4) % 7
    sb = StringBuilder.new()
    cs = pattern.chars
    i = 0
    while i < cs.length {
      c = cs[i]
      if c != "%" or i + 1 >= cs.length {
        sb.push(c)
        i += 1
        continue
      }
      f = cs[i + 1]
      i += 2
      if f == ":" and i < cs.length and cs[i] == "z" {
        f = ":z"
        i += 1
      }
      sb.push(match f {
        "Y" => __time_pad(y, 4),
        "y" => __time_pad(y % 100, 2),
        "C" => __time_pad(y / 100, 2),
        "m" => __time_pad(mo, 2),
        "d" => __time_pad(d, 2),
        "e" => d.to_s.rjust(2),
        "j" => __time_pad(days - __time_days_from_civil(y, 1, 1) + 1, 3),
        "H" => __time_pad(h, 2),
        "I" => __time_pad((h + 11) % 12 + 1, 2),
        "l" => ((h + 11) % 12 + 1).to_s.rjust(2),
        "M" => __time_pad(sod / 60 % 60, 2),
        "S" => __time_pad(sod % 60, 2),
        "L" => __time_pad(self.nanosecond / 1_000_000, 3),
        "f" => __time_pad(self.nanosecond / 1000, 6),
        "N" => __time_pad(self.nanosecond, 9),
        "p" => if h < 12 { "AM" } else { "PM" },
        "P" => if h < 12 { "am" } else { "pm" },
        "a" => __time_weekday_name(wday).slice(0, 3),
        "A" => __time_weekday_name(wday),
        "b" | "h" => __time_month_name(mo).slice(0, 3),
        "B" => __time_month_name(mo),
        "w" => wday.to_s,
        "u" => (if wday == 0 { 7 } else { wday }).to_s,
        "s" => self.unix.to_s,
        "z" => __time_offset_str(self.offset, ""),
        ":z" => __time_offset_str(self.offset, ":"),
        "Z" => if self.offset == 0 { "UTC" } else { __time_offset_str(self.offset, ":") },
        "F" => self.format("%Y-%m-%d"),
        "T" => self.format("%H:%M:%S"),
        "D" => self.format("%m/%d/%y"),
        "R" => self.format("%H:%M"),
        "c" => self.format("%a %b %e %H:%M:%S %Y"),
        "n" => "\n",
        "t" => "\t",
        "%" => "%",
        _ => "%" + f,
      })
    }
    sb.to_s
  }
}

# `a / b` rounded toward zero (Int `/` floors).
fn __time_trunc_div(a: Int, b: Int) -> Int {
  q = a / b
  if q < 0 and q * b != a { q + 1 } else { q }
}

# `n / unit` in decimal, without trailing zeros: `__time_decimal(1500, 1000) == "1.5"`.
fn __time_decimal(n: Int, unit: Int) -> String {
  whole = n / unit
  rest = n % unit
  if rest == 0 { return whole.to_s }
  frac = rest.to_s.rjust(unit.to_s.length - 1, "0")
  while frac.ends_with("0") { frac = frac.delete_suffix("0") }
  "#{whole}.#{frac}"
}

# `n` zero-padded to `width` digits (after any sign).
fn __time_pad(n: Int, width: Int) -> String {
  if n < 0 { "-" + n.abs.to_s.rjust(width, "0") } else { n.to_s.rjust(width, "0") }
}

# `+HH<sep>MM`, plus `<sep>SS` if the offset has seconds.
fn __time_offset_str(offset: Int, sep: String) -> String {
  a = offset.abs
  out = "#{if offset < 0 { "-" } else { "+" }}#{__time_pad(a / 3600, 2)}#{sep}#{__time_pad(a / 60 % 60, 2)}"
  if a % 60 != 0 { out = "#{out}#{sep}#{__time_pad(a % 60, 2)}" }
  out
}

fn __time_check_offset(offset: Int) {
  if offset.abs >= 86400 { panic("ArgumentError: UTC offset #{offset}s is not within ±24 hours") }
}

fn __time_is_leap(y: Int) -> Bool { y % 4 == 0 and (y % 100 != 0 or y % 400 == 0) }

fn __time_days_in_month(y: Int, m: Int) -> Int {
  match m {
    2 => if __time_is_leap(y) { 29 } else { 28 },
    4 | 6 | 9 | 11 => 30,
    _ => 31,
  }
}

# Days since 1970-01-01 of a proleptic Gregorian date, and back (Howard Hinnant's algorithms;
# `/` floors, so they hold for dates before the epoch too).
fn __time_days_from_civil(year: Int, m: Int, d: Int) -> Int {
  y = if m <= 2 { year - 1 } else { year }
  era = y / 400
  yoe = y - era * 400
  mp = if m > 2 { m - 3 } else { m + 9 }
  doy = (153 * mp + 2) / 5 + d - 1
  doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

fn __time_civil(days: Int) -> (Int, Int, Int) {
  z = days + 719468
  era = z / 146097
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  d = doy - (153 * mp + 2) / 5 + 1
  m = if mp < 10 { mp + 3 } else { mp - 9 }
  y = yoe + era * 400
  (if m <= 2 { y + 1 } else { y }, m, d)
}

fn __time_weekday_name(w: Int) -> String {
  ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][w]
}

fn __time_month_name(m: Int) -> String {
  ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"][m - 1]
}

# `n` digits at `cs[at]`, or nil.
fn __time_digits(cs: List[String], at: Int, n: Int) -> Int? {
  if at < 0 or at + n > cs.length { return nil }
  v = 0
  for k in at...(at + n) {
    o = cs[k].ord
    if o < 48 or o > 57 { return nil }
    v = v * 10 + o - 48
  }
  v
}

fn __time_char_at(cs: List[String], at: Int, c: String) -> Bool { at < cs.length and cs[at] == c }

fn __time_parse_iso(cs: List[String]) -> DateTime? {
  n = cs.length
  y = __time_digits(cs, 0, 4)?
  if not __time_char_at(cs, 4, "-") { return nil }
  mo = __time_digits(cs, 5, 2)?
  if not __time_char_at(cs, 7, "-") { return nil }
  d = __time_digits(cs, 8, 2)?
  if mo < 1 or mo > 12 or d < 1 or d > __time_days_in_month(y, mo) { return nil }
  i = 10
  h = 0
  mi = 0
  s = 0
  ns = 0
  off = 0
  if i < n and (cs[i] == "T" or cs[i] == "t" or cs[i] == " ") {
    h = __time_digits(cs, i + 1, 2)?
    if not __time_char_at(cs, i + 3, ":") { return nil }
    mi = __time_digits(cs, i + 4, 2)?
    i += 6
    if __time_char_at(cs, i, ":") {
      s = __time_digits(cs, i + 1, 2)?
      i += 3
      if __time_char_at(cs, i, ".") or __time_char_at(cs, i, ",") {
        i += 1
        start = i
        scale = 100_000_000
        while __time_digits(cs, i, 1) != nil {
          ns += __time_digits(cs, i, 1)! * scale
          scale = scale / 10
          i += 1
        }
        if i == start { return nil }
      }
    }
    if h > 23 or mi > 59 or s > 59 { return nil }
    if i < n {
      sign = cs[i]
      if sign == "Z" or sign == "z" {
        i += 1
      } else if sign == "+" or sign == "-" {
        oh = __time_digits(cs, i + 1, 2)?
        i += 3
        om = 0
        if __time_char_at(cs, i, ":") {
          om = __time_digits(cs, i + 1, 2)?
          i += 3
        } else if let m2 = __time_digits(cs, i, 2) {
          om = m2
          i += 2
        }
        if oh > 23 or om > 59 { return nil }
        off = oh * 3600 + om * 60
        if sign == "-" { off = -off }
      }
    }
  }
  if i != n { return nil }
  local = __time_days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + s
  DateTime.new(local - off, ns, off)
}

pub class Random {
  native fn seed(n: Int)
  native fn int(lo: Int, hi: Int) -> Int
  native fn float() -> Float
  native fn shuffle[T](items: List[T]) -> List[T]
  native fn choice[T](items: List[T]) -> T?
}

# The program's environment variables. `set` and `remove` change what `get` and `all` see and
# what processes started with `Process` inherit, from any thread. They do not change the
# environment of the `catx` process itself (that is unsound while other threads may read it), so
# native code that reads the environment directly does not see them.
pub class Env {
  native fn get(name: String) -> String?
  # `name` must be non-empty and contain no `=`; neither may contain a NUL character.
  native fn set(name: String, value: String)
  native fn remove(name: String)
  # Every variable, sorted by name.
  native fn all() -> Dict[String, String]
  native fn cpu_count() -> Int
}

# Standard input. Reads park the calling fiber (the I/O pool waits) instead of blocking its
# thread. All of these, and the global `read_line()`, read the same buffered stream.
pub class Stdin {
  # The next line without its line ending, or nil at end of input.
  native fn read_line() -> String?
  # The remaining lines, read one at a time as they are iterated:
  # `for line in Stdin.lines() { ... }`. A single pass: each line is read once.
  fn lines() -> StdinLines { StdinLines.new() }
  # All remaining lines at once.
  native fn read_lines() -> List[String]
  # All remaining input (invalid UTF-8 is replaced).
  native fn read_all() -> String
  native fn read_bytes() -> Bytes
}

# The lines of standard input as an `Enumerable[String]`; see `Stdin.lines`.
pub class StdinLines {
  fn each(self, f: fn(String)) {
    loop {
      if let line = Stdin.read_line() { f(line) } else { break }
    }
  }
}

pub class Json {
  native fn parse(text: String) -> Result[Dyn, String]
  native fn stringify(value: Dyn) -> String
  native fn pretty(value: Dyn) -> String
}

# ---------------------------------------------------------------------------------------------
# Networking. A socket operation that would block parks the calling fiber (so one thread can
# serve thousands of connections) or, outside fibers, blocks the thread.

pub class Net {
  # Connects to `host:port`; `timeout` (seconds) bounds the connection attempt.
  native fn connect(host: String, port: Int, timeout: Float? = nil) -> Result[Socket, String]
  # Listens on `host:port`; port 0 picks a free port (see `Listener.port`).
  native fn listen(host: String, port: Int) -> Result[Listener, String]
}

# A TCP connection. Closed by `close`, or when it is garbage.
pub class Socket {
  peer: String
  handle: NativeHandle
  # Up to `max` bytes as text (invalid UTF-8 is replaced); "" at end of stream.
  native fn read(self, max: Int = 65536) -> Result[String, String]
  # The next line without its line ending, or nil at end of stream.
  native fn read_line(self) -> Result[String?, String]
  # Writes all of `data`; returns the number of bytes written.
  native fn write(self, data: String) -> Result[Int, String]
  native fn close(self)
  # Makes reads and writes fail with "timed out" after `seconds` (nil: wait forever).
  native fn set_timeout(self, seconds: Float?)
}

pub class Listener {
  port: Int
  handle: NativeHandle
  native fn accept(self) -> Result[Socket, String]
  native fn close(self)
}

pub class HttpResponse {
  status: Int
  headers: Dict[String, String]
  body: String
  fn ok(self) -> Bool { self.status >= 200 and self.status < 300 }
}

# HTTP and HTTPS client requests. They run on the I/O pool, so a fiber waiting on one lets the
# thread's other fibers run. Non-2xx statuses are responses, not errors.
pub class Http {
  native fn get(url: String, headers: Dict[String, String] = [:]) -> Result[HttpResponse, String]
  native fn post(url: String, body: String, headers: Dict[String, String] = [:]) -> Result[HttpResponse, String]
}

